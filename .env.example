# ========================================================
# ROVE SCENTS • ENVIRONMENT CONFIGURATION
# ========================================================

# MongoDB Cloud Connection String (Free M0 cluster on https://www.mongodb.com/atlas)
# Required for lifetime permanent storage across all devices, phones, and Vercel restarts:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/rove-scents?retryWrites=true&w=majority

# Custom Admin Credentials (Optional - Default: admin / admin123)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Server Port
PORT=5000
